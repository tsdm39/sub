Comment: 0,0:10:14.56,0:10:17.72,对白 日语 上,,0,0,0,,（歓声と拍手）
Comment: 0,0:10:17.72,0:10:23.56,对白 日语 上,,0,0,0,,（歓声）
Dialogue: 0,0:10:20.11,0:10:22.24,对白 日语,Kaede,0,0,0,,ちぇっ ブレーカー狙い?
Dialogue: 1,0:10:20.11,0:10:22.24,对白 中文,Kaede,0,0,0,,
Comment: 1,0:10:20.11,0:10:22.24,Ruby,Kaede,0,0,0,,
Dialogue: 0,0:10:22.24,0:10:23.79,对白 日语,Kaede,0,0,0,,つまらないもん…
Dialogue: 1,0:10:22.24,0:10:23.79,对白 中文,Kaede,0,0,0,,
Dialogue: 0,0:10:23.79,0:10:26.10,对白 日语,一同,0,0,0,推定,うぉ～!
Dialogue: 1,0:10:23.79,0:10:26.10,对白 中文,一同,0,0,0,,
Dialogue: 0,0:10:23.79,0:10:26.10,对白 日语 上,Kaede,0,0,0,,生配信は中断かぁ…
Dialogue: 1,0:10:23.79,0:10:26.10,对白 中文 上,Kaede,0,0,0,,
Dialogue: 0,0:10:26.52,0:10:31.11,对白 日语,Kaede,0,0,0,,貴重な試合を勝手に録って 観客のスマホも預かっているし
Dialogue: 1,0:10:26.52,0:10:31.11,对白 中文,Kaede,0,0,0,,
Dialogue: 0,0:10:31.11,0:10:33.69,对白 日语,Kaede,0,0,0,,その辺の動画サイトに 流されないよう
Dialogue: 1,0:10:31.11,0:10:33.69,对白 中文,Kaede,0,0,0,,
Dialogue: 0,0:10:34.26,0:10:35.07,对白 日语,Kaede,0,0,0,,残念
Dialogue: 1,0:10:34.26,0:10:35.07,对白 中文,Kaede,0,0,0,,
Dialogue: 0,0:10:35.33,0:10:40.55,对白 日语,Kinuhata,0,0,0,,世界全体公開で 顔をさらすなんて 裏家業としちゃ最悪ですからね
Dialogue: 1,0:10:35.33,0:10:40.55,对白 中文,Kinuhata,0,0,0,,
Dialogue: 0,0:10:40.55,0:10:42.54,对白 日语,Frenda,0,0,0,,結局 ギリギリ回避よ
Dialogue: 1,0:10:40.55,0:10:42.54,对白 中文,Frenda,0,0,0,,
Comment: 1,0:10:40.55,0:10:42.54,Ruby,Frenda,0,0,0,,
Dialogue: 0,0:10:46.23,0:10:48.21,对白 日语,Waniguchi,0,0,0,,でも 殺すのは変わらない
Dialogue: 1,0:10:46.23,0:10:48.21,对白 中文,Waniguchi,0,0,0,,
Dialogue: 0,0:10:48.54,0:10:50.79,对白 日语,Waniguchi,0,0,0,,会場のみの イベントになっちまったが
Dialogue: 1,0:10:48.54,0:10:50.79,对白 中文,Waniguchi,0,0,0,,
Comment: 1,0:10:48.54,0:10:50.79,Ruby,Waniguchi,0,0,0,,
Dialogue: 0,0:10:50.79,0:10:53.67,对白 日语,Waniguchi,0,0,0,,その分 ゴアにいかせてもらうぜ!!
Dialogue: 1,0:10:50.79,0:10:53.67,对白 中文,Waniguchi,0,0,0,,
Comment: 0,0:10:56.44,0:11:00.95,对白 日语 上,,0,0,0,,（歓声）
Dialogue: 0,0:10:58.55,0:11:02.52,对白 日语,Frenda,0,0,0,,どんな戦い方するのか 全く見えないんだから慎重に…
Dialogue: 1,0:10:58.55,0:11:02.52,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:11:02.52,0:11:03.32,对白 日语,Frenda,0,0,0,,ちょっ…!
Dialogue: 1,0:11:02.52,0:11:03.32,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:11:03.52,0:11:06.98,对白 日语,Waniguchi,0,0,0,,小細工抜きかよ 気にいったぜ 生ゴミ!
Dialogue: 1,0:11:03.52,0:11:06.98,对白 中文,Waniguchi,0,0,0,,
Dialogue: 0,0:11:06.98,0:11:11.70,对白 日语,Waniguchi,0,0,0,,てめえは肉塊だが 敬意を持って輝く肉塊に デコってやるよ～!
Dialogue: 1,0:11:06.98,0:11:11.70,对白 中文,Waniguchi,0,0,0,,
Dialogue: 0,0:11:12.35,0:11:14.36,对白 日语,Waniguchi,0,0,0,推定,はっ!
Dialogue: 1,0:11:12.35,0:11:14.36,对白 中文,Waniguchi,0,0,0,,
Dialogue: 0,0:11:17.61,0:11:19.18,对白 日语,Frenda,0,0,0,,アホかっ! 結局
Dialogue: 1,0:11:17.61,0:11:19.18,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:11:19.18,0:11:21.36,对白 日语,Frenda,0,0,0,,頑丈だからってだけで とりあえず
Dialogue: 1,0:11:19.18,0:11:21.36,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:11:21.36,0:11:25.58,对白 日语,Frenda,0,0,0,,突っ込んで 体当たりで 情報 引き出そうとするクセは 直しなさいよね!
Dialogue: 1,0:11:21.36,0:11:25.58,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:11:25.58,0:11:26.83,对白 日语,Kinuhata,0,0,0,,超危ない! ぐおっ!
Dialogue: 1,0:11:25.58,0:11:26.83,对白 中文,Kinuhata,0,0,0,,
Dialogue: 0,0:11:29.24,0:11:33.29,对白 日语,Kinuhata,0,0,0,,殺し合いの最中に 超立ち止まって 長々と説教タイムとか
Dialogue: 1,0:11:29.24,0:11:33.29,对白 中文,Kinuhata,0,0,0,,
Dialogue: 0,0:11:33.29,0:11:35.22,对白 日语,Kinuhata,0,0,0,,余裕で死ぬやつですか それ!
Dialogue: 1,0:11:33.29,0:11:35.22,对白 中文,Kinuhata,0,0,0,,
Dialogue: 0,0:11:35.62,0:11:41.18,对白 日语,Frenda,0,0,0,,くっ…おま ぶぐう… 命の恩人に全力で仕返しとか…
Dialogue: 1,0:11:35.62,0:11:41.18,对白 中文,Frenda,0,0,0,,
Comment: 0,0:11:40.89,0:11:45.23,对白 日语 上,,0,0,0,,（足音）
Dialogue: 0,0:11:41.18,0:11:44.27,对白 日语,Frenda,0,0,0,,結局 メチャクチャ反抗期なわけ?
Dialogue: 1,0:11:41.18,0:11:44.27,对白 中文,Frenda,0,0,0,,
Comment: 1,0:11:41.18,0:11:44.27,Ruby,Frenda,0,0,0,,
Comment: 0,0:11:45.23,0:11:48.03,对白 日语 上,,0,0,0,,（うなり声）
Dialogue: 0,0:11:50.62,0:11:52.68,对白 日语,Kaede,0,0,0,,ホワイトタイガーが強すぎて
Dialogue: 1,0:11:50.62,0:11:52.68,对白 中文,Kaede,0,0,0,,
Comment: 1,0:11:50.62,0:11:52.68,Ruby,Kaede,0,0,0,,
Dialogue: 0,0:11:52.68,0:11:56.81,对白 日语,Kaede,0,0,0,,今日の選手たちを バラバラにしちゃった場合の 保険だったのよね
Dialogue: 1,0:11:52.68,0:11:56.81,对白 中文,Kaede,0,0,0,,
Comment: 1,0:11:52.68,0:11:56.81,Ruby,Kaede,0,0,0,,
Dialogue: 0,0:11:56.81,0:11:59.40,对白 日语,Kaede,0,0,0,,猛獣同士でごまかすというか ふふ…
Dialogue: 1,0:11:56.81,0:11:59.40,对白 中文,Kaede,0,0,0,,
Dialogue: 0,0:11:59.99,0:12:04.39,对白 日语,Frenda,0,0,0,,これが 結局 動物を操るのが あの女の能力
Dialogue: 1,0:11:59.99,0:12:04.39,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:12:04.39,0:12:07.79,对白 日语,Kinuhata,0,0,0,,違いますよ 超それじゃ筋が通らない
Dialogue: 1,0:12:04.39,0:12:07.79,对白 中文,Kinuhata,0,0,0,,
Dialogue: 0,0:12:07.79,0:12:10.58,对白 日语,Kinuhata,0,0,0,,さっき 天井や壁を ぶっ壊したのは何なんですか?
Dialogue: 1,0:12:07.79,0:12:10.58,对白 中文,Kinuhata,0,0,0,,
Dialogue: 0,0:12:10.89,0:12:15.06,对白 日语,Kinuhata,0,0,0,,それに地味ですけど マイクが 超ひとりでに 宙を舞ったのだって… ふふ…
Dialogue: 1,0:12:10.89,0:12:15.06,对白 中文,Kinuhata,0,0,0,,
Comment: 0,0:12:16.27,0:12:18.27,对白 日语 上,,0,0,0,,（うなり声）
Dialogue: 0,0:12:18.45,0:12:20.43,对白 日语,Waniguchi,0,0,0,,クマちゃんばっか見てんなよ～!
Dialogue: 1,0:12:18.45,0:12:20.43,对白 中文,Waniguchi,0,0,0,,
Comment: 0,0:12:20.94,0:12:35.96,对白 日语 上,,0,0,0,,～
Dialogue: 0,0:12:35.87,0:12:37.90,对白 日语,Frenda,0,0,0,,結局…マジか?
Dialogue: 1,0:12:35.87,0:12:37.90,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:12:38.22,0:12:43.05,对白 日语,Waniguchi,0,0,0,,チーフ 動物いじくるのはいいけど あたしを巻き込んでるってば～
Dialogue: 1,0:12:38.22,0:12:43.05,对白 中文,Waniguchi,0,0,0,,
Dialogue: 0,0:12:43.47,0:12:46.49,对白 日语,Kaede,0,0,0,,ふふ ごめんなさい あなた 許してちょうだい
Dialogue: 1,0:12:43.47,0:12:46.49,对白 中文,Kaede,0,0,0,,
Dialogue: 0,0:12:46.49,0:12:49.41,对白 日语,Kaede,0,0,0,,ちょっと コントロールを 失敗したみたい
Dialogue: 1,0:12:46.49,0:12:49.41,对白 中文,Kaede,0,0,0,,
Comment: 1,0:12:46.49,0:12:49.41,Ruby,Kaede,0,0,0,,
Dialogue: 0,0:12:49.41,0:12:50.37,对白 日语,Waniguchi,0,0,0,,もう～
Dialogue: 1,0:12:49.41,0:12:50.37,对白 中文,Waniguchi,0,0,0,,
Dialogue: 0,0:12:51.03,0:12:53.77,对白 日语 上,Frenda,0,0,0,,あんなやつに 私の武器が通じるの?
Dialogue: 1,0:12:51.03,0:12:53.77,对白 中文 上,Frenda,0,0,0,,
Dialogue: 0,0:13:03.42,0:13:05.45,对白 日语,Waniguchi,0,0,0,,レバレッジストラグル!
Dialogue: 1,0:13:03.42,0:13:05.45,对白 中文,Waniguchi,0,0,0,,
Comment: 1,0:13:03.42,0:13:05.45,Ruby,Waniguchi,0,0,0,,
Dialogue: 0,0:13:05.45,0:13:07.98,对白 日语,Waniguchi,0,0,0,,別に隠しているわけじゃあねえ
Dialogue: 1,0:13:05.45,0:13:07.98,对白 中文,Waniguchi,0,0,0,,
Dialogue: 0,0:13:07.98,0:13:11.53,对白 日语,Waniguchi,0,0,0,,ルール違反への処刑動画で さらしている能力だし
Dialogue: 1,0:13:07.98,0:13:11.53,对白 中文,Waniguchi,0,0,0,,
Dialogue: 0,0:13:11.53,0:13:14.96,对白 日语,Waniguchi,0,0,0,,ハサミ バール シーソー そして関節技
Dialogue: 1,0:13:11.53,0:13:14.96,对白 中文,Waniguchi,0,0,0,,
Comment: 1,0:13:11.53,0:13:14.96,Ruby,Waniguchi,0,0,0,,
Dialogue: 0,0:13:14.96,0:13:17.79,对白 日语,Waniguchi,0,0,0,,てこの原理は 全て あたしの武器になる
Dialogue: 1,0:13:14.96,0:13:17.79,对白 中文,Waniguchi,0,0,0,,
Dialogue: 0,0:13:18.11,0:13:22.89,对白 日语,Waniguchi,0,0,0,,ああ あんたの胴まわりと同じ コンクリの柱でも素手でねじ切れる
Dialogue: 1,0:13:18.11,0:13:22.89,对白 中文,Waniguchi,0,0,0,,
Comment: 1,0:13:18.11,0:13:22.89,Ruby,Waniguchi,0,0,0,,
Dialogue: 0,0:13:22.89,0:13:25.12,对白 日语,Waniguchi,0,0,0,,倍の太さでも余裕だぜ!
Dialogue: 1,0:13:22.89,0:13:25.12,对白 中文,Waniguchi,0,0,0,,
Dialogue: 0,0:13:25.51,0:13:29.00,对白 日语,Kinuhata,0,0,0,,超本気で言っているんですか? ド級のアホは
Dialogue: 1,0:13:25.51,0:13:29.00,对白 中文,Kinuhata,0,0,0,,
Dialogue: 0,0:13:37.38,0:13:38.96,对白 日语,Frenda,0,0,0,,ちょ…何してんの!?
Dialogue: 1,0:13:37.38,0:13:38.96,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:13:39.48,0:13:44.43,对白 日语,Kaede,0,0,0,,あらら 花山ちゃんの 摩擦対応被覆ジェル 取られちゃったわね
Dialogue: 1,0:13:39.48,0:13:44.43,对白 中文,Kaede,0,0,0,,
Comment: 0,0:13:42.96,0:13:44.96,对白 日语 上,,0,0,0,,（缶を捨てる音）
Dialogue: 0,0:13:44.43,0:13:48.56,对白 日语,Kinuhata,0,0,0,,てこの原理を使った関節技
Dialogue: 1,0:13:44.43,0:13:48.56,对白 中文,Kinuhata,0,0,0,,
Dialogue: 0,0:13:48.56,0:13:51.39,对白 日语,Kinuhata,0,0,0,,増幅するのが 超それだけなら つかまれなければ怖くない
Dialogue: 1,0:13:48.56,0:13:51.39,对白 中文,Kinuhata,0,0,0,,
Dialogue: 0,0:13:52.02,0:13:55.15,对白 日语,Frenda,0,0,0,,にしたって 乙女としては やること雑すぎない?
Dialogue: 1,0:13:52.02,0:13:55.15,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:13:55.15,0:13:58.85,对白 日语,Kinuhata,0,0,0,,聞いてもいないのに 勝手に べらべらしゃべりやがって
Dialogue: 1,0:13:55.15,0:13:58.85,对白 中文,Kinuhata,0,0,0,,
Dialogue: 0,0:13:58.85,0:14:02.63,对白 日语,Kinuhata,0,0,0,,あなたを殺す方法なんか 超いくらでもあるんですよ
Dialogue: 1,0:13:58.85,0:14:02.63,对白 中文,Kinuhata,0,0,0,,
Dialogue: 0,0:14:02.74,0:14:05.58,对白 日语,Kinuhata,0,0,0,推定,う…ぐ…
Dialogue: 1,0:14:02.74,0:14:05.58,对白 中文,Kinuhata,0,0,0,,
Dialogue: 0,0:14:05.94,0:14:08.85,对白 日语,Kaede,0,0,0,,ほら 鰐口ちゃん 泣かないでちょうだい
Dialogue: 1,0:14:05.94,0:14:08.85,对白 中文,Kaede,0,0,0,,
Dialogue: 0,0:14:08.85,0:14:11.87,对白 日语,Kaede,0,0,0,,だから自ら 能力を 明かすものじゃないでしょ?
Dialogue: 1,0:14:08.85,0:14:11.87,对白 中文,Kaede,0,0,0,,
Dialogue: 0,0:14:13.08,0:14:14.81,对白 日语,Waniguchi,0,0,0,,うぅ～ チーフ!
Dialogue: 1,0:14:13.08,0:14:14.81,对白 中文,Waniguchi,0,0,0,,
Dialogue: 0,0:14:14.81,0:14:18.82,对白 日语,Kaede,0,0,0,,それから あなた ぬるぬるしていて 素手でつかめなくても
Dialogue: 1,0:14:14.81,0:14:18.82,对白 中文,Kaede,0,0,0,,
Dialogue: 0,0:14:18.82,0:14:23.50,对白 日语,Kaede,0,0,0,,ペンチを使えば 打撃や 毟りに近い 接近戦はできるもん
Dialogue: 1,0:14:18.82,0:14:23.50,对白 中文,Kaede,0,0,0,,
Dialogue: 0,0:14:24.12,0:14:27.86,对白 日语,Kaede,0,0,0,,トリッキーな作戦も使えるのに 考えを狭めるのは
Dialogue: 1,0:14:24.12,0:14:27.86,对白 中文,Kaede,0,0,0,,
Comment: 1,0:14:24.12,0:14:27.86,Ruby,Kaede,0,0,0,,
Dialogue: 0,0:14:27.86,0:14:29.90,对白 日语,Kaede,0,0,0,,賢いとはいえないわ うぅ…
Dialogue: 1,0:14:27.86,0:14:29.90,对白 中文,Kaede,0,0,0,,
Dialogue: 0,0:14:30.27,0:14:33.98,对白 日语,Waniguchi,0,0,0,,ぞっぢがらも 刺じでごないでよぉ～っ!!
Dialogue: 1,0:14:30.27,0:14:33.98,对白 中文,Waniguchi,0,0,0,,
Comment: 0,0:14:35.65,0:14:35.65,注释,,0,0,0,,p3
Dialogue: 0,0:14:35.65,0:14:37.13,对白 日语,Kaede,0,0,0,,よしよし
Dialogue: 1,0:14:35.65,0:14:37.13,对白 中文,Kaede,0,0,0,,
Dialogue: 0,0:14:37.13,0:14:38.59,对白 日语,Kinuhata,0,0,0,,余裕ですね
Dialogue: 1,0:14:37.13,0:14:38.59,对白 中文,Kinuhata,0,0,0,,
Dialogue: 0,0:14:38.59,0:14:43.65,对白 日语,Kinuhata,0,0,0,,そこのアホをかばったまま 実質 一対二で 私たちと 超やり合って勝てるとでも?
Dialogue: 1,0:14:38.59,0:14:43.65,对白 中文,Kinuhata,0,0,0,,
Dialogue: 0,0:14:44.51,0:14:48.66,对白 日语,Kinuhata,0,0,0,,あなたのほうまで 脳筋じゃないことを 超祈っていますけど
Dialogue: 1,0:14:44.51,0:14:48.66,对白 中文,Kinuhata,0,0,0,,
Dialogue: 0,0:14:49.07,0:14:50.91,对白 日语,Kaede,0,0,0,,ふふっ そうね そのとおり
Dialogue: 1,0:14:49.07,0:14:50.91,对白 中文,Kaede,0,0,0,,
Dialogue: 0,0:14:52.30,0:14:54.49,对白 日语,Kaede,0,0,0,,それでも 勝つのはこちら
Dialogue: 1,0:14:52.30,0:14:54.49,对白 中文,Kaede,0,0,0,,
